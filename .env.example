# HeatMind Environment Variables

# FortyGuard API (required for live data)
FORTYGUARD_API_KEY=your_api_key_here

# LLM provider — pick one: openai | anthropic | gemini | ollama
# Leave LLM_PROVIDER empty to use the built-in Mock LLM (deterministic, offline).
LLM_PROVIDER=
LLM_MODEL=

# Provider keys (only the one matching LLM_PROVIDER is needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional self-hosted LLM (e.g. llama3.1 via Ollama on localhost)
OLLAMA_BASE_URL=http://localhost:11434

# MongoDB — use MongoDB Atlas free tier (https://cloud.mongodb.com)
# Free tier: 512MB storage, shared cluster
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/heatmind?retryWrites=true&w=majority
MONGO_DB=heatmind

# Slack Alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Alerting (optional — configure what you need)
ALERT_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL_TO=recipient@example.com

# Monitor settings
MONITOR_INTERVAL_MINUTES=30
HEAT_THRESHOLD_C=40
HEAT_INDEX_THRESHOLD=45

# Test mode (set to true to skip real API calls)
TEST_MODE=false

# Demo mode (set to true to run the full autonomous agent loop with
# synthetic FortyGuard data — no API key or LLM key required). Great for
# demos and the submission video.
HEATMIND_DEMO_MODE=false
